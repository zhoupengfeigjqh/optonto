      },
      "required": ["data", "aggregations"]
    }
  },
  {
    "name": "groupReduce",
    "display_name": "分组汇总",
    "description": "按字段分组后聚合统计，支持 having 过滤、order_by 排序、top_n 截取。聚合函数：sum, avg/mean, count, count_distinct, min, max, std, var, median。返回分组结果记录数组及条数。",
    "response": {"result": {"type": "array", "display_name": "分组结果", "description": "分组聚合后的记录数组（另附 count 条数）"}},
    "inputSchema": {
      "type": "object",
      "properties": {
        "data": {"type": "array", "items": {"type": "object"}, "display_name": "数据", "description": "JSON 记录数组（对象列表）"},
        "group_by": {"type": "array", "items": {"type": "string"}, "display_name": "分组字段", "description": "分组字段名数组"},
        "aggregations": {"type": "array", "items": {"type": "object"}, "display_name": "聚合定义", "description": "聚合定义数组，每项为 {field, functions, alias?}；functions 取值见函数描述"},
        "having": {"type": "array", "items": {"type": "object"}, "display_name": "组后过滤", "description": "可选。对聚合结果列过滤，每项为 {field, operator, value}"},
