        "logic": {"type": "string", "enum": ["AND", "OR"], "display_name": "组合逻辑", "description": "多条件组合逻辑，默认 AND"}
      },
      "required": ["data", "conditions"]
    }
  },
  {
    "name": "aggregateData",
    "display_name": "聚合统计",
    "description": "对 JSON 数组做整体聚合统计。聚合函数：sum, avg/mean, count, count_distinct, min, max, std, var, median, mode。返回各指标键值对（键为 字段_聚合函数 或指定 alias）。",
    "response": {"result": {"type": "object", "display_name": "聚合结果", "description": "各聚合指标的键值对"}},
    "inputSchema": {
