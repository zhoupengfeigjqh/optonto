FROM python:3.12-slim

WORKDIR /app

# Install only needed dependencies
COPY core-backend/requirements.mcp.txt .
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -r requirements.mcp.txt

# Copy only the MCP server file
COPY core-backend/mcp_server_sse.py ./mcp_server_sse.py

EXPOSE 8002

CMD ["sh", "-c", "python -m uvicorn mcp_server_sse:starlette_app --host 0.0.0.0 --port 8002"]
