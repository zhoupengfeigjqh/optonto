{
  "ruleName": "推理规则",
  "type": "object",
  "properties": {
    "if": {
      "type": "object",
      "properties": {
        "logic": {
          "type": "string",
          "enum": [
            "and",
            "or"
          ],
          "description": "多个条件之间的逻辑关系，默认为 and",
          "default": "and"
        },
        "conditions": {
          "type": "array",
          "description": "条件列表，至少包含一个条件",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "left": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "concept",
                      "function"
                    ],
                    "description": "左侧数据来源类型"
                  },
                  "concept": {
                    "type": "string",
                    "description": "概念名称，如 Person、Order"
                  },
                  "attribute": {
                    "type": "string",
                    "description": "属性名称，如 age、amount"
                  },
                  "function": {
                    "type": "string",
                    "description": "函数名称，如 sum、avg、count、max、min"
                  },
                  "returnField": {
                    "type": "string",
                    "description": "函数返回字段名称，如 total、average"
                  }
                },
                "required": [
                  "type"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "concept"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "concept",
                        "attribute"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "function"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "function",
                        "returnField"
                      ]
                    }
                  }
                ]
              },
              "operator": {
                "type": "string",
                "enum": [
                  "eq",
                  "ne",
                  "like",
                  "match",
                  "lt",
                  "gt",
                  "le",
                  "ge"
                ],
                "description": "eq=等于, ne=不等于,  lt=小于, gt=大于, le=小于等于, ge=大于等于"
              },
              "right": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "value",
                      "concept",
                      "function"
                    ],
                    "description": "右侧数据来源类型"
                  },
                  "value": {
                    "description": "字面值，当 type=value 时使用，支持 string/number/boolean"
                  },
                  "concept": {
                    "type": "string",
                    "description": "概念名称，当 type=concept 时使用"
                  },
                  "attribute": {
                    "type": "string",
                    "description": "属性名称，当 type=concept 时使用"
                  },
                  "function": {
                    "type": "string",
                    "description": "函数名称，当 type=function 时使用"
                  },
                  "returnField": {
                    "type": "string",
                    "description": "函数返回字段名称，当 type=function 时使用"
                  }
                },
                "required": [
                  "type"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "value"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "value"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "concept"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "concept",
                        "attribute"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "function"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "function",
                        "returnField"
                      ]
                    }
                  }
                ]
              }
            },
            "required": [
              "left",
              "operator",
              "right"
            ]
          }
        }
      },
      "required": [
        "conditions"
      ]
    },
    "then": {
      "type": "string",
      "description": "条件为真时的文字描述，填写一段话说明应执行的行为或提示"
    },
    "else": {
      "type": "string",
      "description": "条件为假时的文字描述，填写一段话说明应执行的行为或提示"
    }
  },
  "required": [
    "if",
    "then",
    "else"
  ]
}